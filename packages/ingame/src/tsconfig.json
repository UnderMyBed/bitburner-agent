{
  // In-game code runs in the game's page: browser globals, no Node. The NS API's types are the pinned game's own
  // definitions, under the game's own alias `@nsdefs`. tools/upstream-watch typechecks this code against upstream's
  // definitions by replacing `paths` whole: an alias added here must be added there too (a test checks).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "paths": {
      "@nsdefs": ["../../../vendor/bitburner-src/src/ScriptEditor/NetscriptDefinitions.d.ts"]
    }
  },
  "include": ["**/*.ts"]
}
