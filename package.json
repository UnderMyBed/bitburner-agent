{
  "name": "bitburner-agent",
  "private": true,
  "description": "An autonomous agent that plays Bitburner from a fresh save to every Source-File maxed.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node tools/bootstrap/cli.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "setup:engine": "node packages/sim/scripts/setup-engine.ts",
    "build:engine": "node packages/sim/scripts/build-engine.ts",
    "sim": "node packages/sim/scripts/run-scenario.ts",
    "brain": "node packages/brain/src/main.ts",
    "gaps": "node packages/brain/src/gaps-cli.ts",
    "e2:build": "node packages/e2/scripts/build-game.ts",
    "e2:install": "node packages/e2/scripts/install-browser.ts",
    "e2": "vitest run --config packages/e2/vitest.config.ts",
    "typecheck": "node tools/typecheck/cli.ts && node packages/sim/scripts/typecheck-bundle.ts",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
